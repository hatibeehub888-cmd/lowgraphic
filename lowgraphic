local yPos = 0

local function createSetting(label, settingKey, defaultValue, min, max)
	-- ラベル
	local labelText = Instance.new("TextLabel")
	labelText.Size = UDim2.new(1, -16, 0, 22)
	labelText.Position = UDim2.new(0, 8, 0, yPos)
	labelText.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	labelText.Text = label .. ": " .. tostring(_G.GraphicsSettings[settingKey])
	labelText.TextColor3 = Color3.new(1, 1, 1)
	labelText.Font = Enum.Font.Gotham
	labelText.TextSize = 11
	labelText.Parent = ScrollFrame

	local labelCorner = Instance.new("UICorner")
	labelCorner.CornerRadius = UDim.new(0, 4)
	labelCorner.Parent = labelText

	yPos = yPos + 28

	-- テキストボックス
	local textBox = Instance.new("TextBox")
	textBox.Size = UDim2.new(0.65, -8, 0, 28)
	textBox.Position = UDim2.new(0, 8, 0, yPos)
	textBox.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	textBox.TextColor3 = Color3.new(1, 1, 1)
	textBox.Font = Enum.Font.GothamBold
	textBox.TextSize = 12
	textBox.Text = tostring(_G.GraphicsSettings[settingKey])
	textBox.PlaceholderText = min .. "-" .. max
	textBox.Parent = ScrollFrame

	local textBoxCorner = Instance.new("UICorner")
	textBoxCorner.CornerRadius = UDim.new(0, 4)
	textBoxCorner.Parent = textBox

	-- ON/OFF ボタン
	local toggleBtn = Instance.new("TextButton")
	toggleBtn.Size = UDim2.new(0.3, 0, 0, 28)
	toggleBtn.Position = UDim2.new(0.68, 0, 0, yPos)
	toggleBtn.BackgroundColor3 = Color3.fromRGB(140, 40, 40)
	toggleBtn.Text = "OFF"
	toggleBtn.TextColor3 = Color3.new(1, 1, 1)
	toggleBtn.Font = Enum.Font.GothamBold
	toggleBtn.TextSize = 10
	toggleBtn.Parent = ScrollFrame

	local toggleCorner = Instance.new("UICorner")
	toggleCorner.CornerRadius = UDim.new(0, 4)
	toggleCorner.Parent = toggleBtn

	yPos = yPos + 34

	-- 更新処理
	local function updateValue()
		local val = tonumber(textBox.Text)
		if val then
			val = math.clamp(val, min, max)
			_G.GraphicsSettings[settingKey] = val
			textBox.Text = tostring(val)
			labelText.Text = label .. ": " .. tostring(val)
			fn18()  -- ★ その場で反映
		end
	end

	textBox.FocusLost:Connect(function()
		updateValue()
	end)

	local enabled = false
	toggleBtn.MouseButton1Click:Connect(function()
		enabled = not enabled
		toggleBtn.Text = enabled and "ON" or "OFF"
		toggleBtn.BackgroundColor3 = enabled and Color3.fromRGB(0, 140, 60) or Color3.fromRGB(140, 40, 40)
		textBox.Visible = enabled

		if enabled then
			-- テキストボックスから値を取得
			local val = tonumber(textBox.Text) or defaultValue
			val = math.clamp(val, min, max)
			_G.GraphicsSettings[settingKey] = val
			textBox.Text = tostring(val)
			labelText.Text = label .. ": " .. tostring(val)
		else
			_G.GraphicsSettings[settingKey] = defaultValue
			textBox.Text = tostring(defaultValue)
			labelText.Text = label .. ": " .. tostring(defaultValue)
		end
		fn18()  -- ★ その場で反映
	end)

	textBox.Visible = false

	-- 保存して後で更新用
	table.insert(UIElements, {
		labelText = labelText,
		textBox = textBox,
		toggleBtn = toggleBtn,
		settingKey = settingKey,
		defaultValue = defaultValue
	})
end

