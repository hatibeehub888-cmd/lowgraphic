local function createToggleSetting(label, settingKey)
	local toggleBtn = Instance.new("TextButton")
	toggleBtn.Size = UDim2.new(1, -16, 0, 32)
	toggleBtn.Position = UDim2.new(0, 8, 0, toggleYPos)
	toggleBtn.BackgroundColor3 = Color3.fromRGB(140, 40, 40)
	toggleBtn.Text = label .. ": OFF"
	toggleBtn.TextColor3 = Color3.new(1, 1, 1)
	toggleBtn.Font = Enum.Font.GothamBold
	toggleBtn.TextSize = 12
	toggleBtn.Parent = ScrollFrame

	local toggleCorner = Instance.new("UICorner")
	toggleCorner.CornerRadius = UDim.new(0, 6)
	toggleCorner.Parent = toggleBtn

	toggleBtn.MouseButton1Click:Connect(function()
		_G.GraphicsSettings[settingKey] = not _G.GraphicsSettings[settingKey]
		toggleBtn.Text = label .. ": " .. (_G.GraphicsSettings[settingKey] and "ON" or "OFF")
		toggleBtn.BackgroundColor3 = _G.GraphicsSettings[settingKey] and Color3.fromRGB(0, 140, 60) or Color3.fromRGB(140, 40, 40)
		fn18()  -- ★ その場で反映
		print("[Graphics] " .. label .. ": " .. (_G.GraphicsSettings[settingKey] and "有効" or "無効"))
	end)

	toggleYPos = toggleYPos + 38
end

