-- 調整可能な全パラメータ（初期値すべて 0 / false）
_G.GraphicsSettings = {
	-- Part / Union 設定
	Part_Transparency = 0,
	Part_Reflectance = 0,
	Part_Material = false,
	Part_CanCollide = false,
	
	-- Decal / Texture 設定
	Decal_Transparency = 0,
	
	-- ParticleEmitter 設定
	Particle_LifetimeMin = 0,
	Particle_LifetimeMax = 0,
	Particle_Enabled = false,
	
	-- Explosion 設定
	Explosion_BlastPressure = 1,
	Explosion_BlastRadius = 1,
	
	-- Fire / Smoke / SpotLight 設定
	Effects_Enabled = false,
}

local function fn17(arg)
	if not _G.G_LowGraphics then
		return
	end
	
	local settings = _G.GraphicsSettings
	
	if arg:IsA("Part") or arg:IsA("Union") or arg:IsA("CornerWedgePart") or arg:IsA("TrussPart") then
		if settings.Part_Material then
			arg.Material = Enum.Material.SmoothPlastic
		end
		arg.Reflectance = settings.Part_Reflectance
		arg.Transparency = settings.Part_Transparency
		if settings.Part_CanCollide then
			pcall(function()
				arg.CanCollide = false
			end)
		end
	elseif arg:IsA("Decal") or arg:IsA("Texture") then
		arg.Transparency = settings.Decal_Transparency
	elseif arg:IsA("ParticleEmitter") or arg:IsA("Trail") then
		arg.Lifetime = NumberRange.new(settings.Particle_LifetimeMin, settings.Particle_LifetimeMax)
		arg.Enabled = settings.Particle_Enabled
	elseif arg:IsA("Explosion") then
		arg.BlastPressure = settings.Explosion_BlastPressure
		arg.BlastRadius = settings.Explosion_BlastRadius
	elseif arg:IsA("Fire") or arg:IsA("SpotLight") or arg:IsA("Smoke") then
		arg.Enabled = settings.Effects_Enabled
	end
end

local function fn18()
	task.spawn(function()
		pcall(function()
			local n = 0

			for _, descendant in pairs(game:GetDescendants()) do
				pcall(function()
					fn17(descendant)
				end)
				n += 1

				if n % 500 == 0 then
					task.wait()
				end
			end
		end)

		print("[Graphics] 画質調整処理完了")
	end)
end

-- ★ 初期状態では処理を実行しない
-- fn18()

game:GetService("Workspace").DescendantAdded:Connect(function(descendant)
	if _G.G_LowGraphics then
		pcall(function()
			fn17(descendant)
		end)
	end
end)

