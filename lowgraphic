local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

_G.G_LowGraphics = true
_G.GraphicsLevel_Transparency = 0  -- 0-10
_G.GraphicsLevel_Reflectance = 0   -- 0-10
_G.GraphicsLevel_Material = false  -- Plastic 変更 ON/OFF

-- ============================================================
-- Graphics 関数群
-- ============================================================

local function fn17(arg)
	if arg:IsA("Part") or arg:IsA("Union") or arg:IsA("CornerWedgePart") or arg:IsA("TrussPart") then
		if _G.GraphicsLevel_Material then
			arg.Material = Enum.Material.SmoothPlastic
		end
		if _G.GraphicsLevel_Reflectance > 0 then
			arg.Reflectance = _G.GraphicsLevel_Reflectance / 10
		end
		if _G.GraphicsLevel_Transparency > 0 then
			arg.Transparency = _G.GraphicsLevel_Transparency / 10
		end
	elseif arg:IsA("Decal") or arg:IsA("Texture") then
		if _G.GraphicsLevel_Transparency > 0 then
			arg.Transparency = _G.GraphicsLevel_Transparency / 10
		end
	elseif arg:IsA("ParticleEmitter") or arg:IsA("Trail") then
		arg.Lifetime = NumberRange.new(0)
	elseif arg:IsA("Explosion") then
		arg.BlastPressure = 1
		arg.BlastRadius = 1
	elseif arg:IsA("Fire") or arg:IsA("SpotLight") or arg:IsA("Smoke") then
		arg.Enabled = false
	end
end

local function fn18()
	task.spawn(function()
		pcall(function()
			local n = 0

			for _, descendant in pairs(game:GetDescendants()) do
				pcall(function()
					fn17(descendant)
				end)
				n += 1

				if n % 500 == 0 then
					task.wait()
				end
			end
		end)

		print("[Graphics] 画質調整処理完了")
	end)
end

_G.G_LowGraphics = true
fn18()

game:GetService("Workspace").DescendantAdded:Connect(function(descendant)
	if _G.G_LowGraphics then
		pcall(function()
			fn17(descendant)
		end)
	end
end)

