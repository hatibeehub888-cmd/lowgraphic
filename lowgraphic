local function updateLevel(newLevel)
	_G.GraphicsLevel = math.clamp(newLevel, 0, 100)
	LevelLabel.Text = "Graphics Level: " .. _G.GraphicsLevel .. "/100"
	LevelFill.Size = UDim2.new(_G.GraphicsLevel / 100, 0, 1, 0)

	for _, descendant in ipairs(game:GetDescendants()) do
		pcall(function()
			fn17(descendant)
		end)
	end
end

local draggingLevel = false
LevelBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingLevel = true
	end
end)

LevelBar.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingLevel = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if draggingLevel and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local mouse = game:GetService("Mouse")
		local sliderPos = LevelBar.AbsolutePosition.X
		local sliderSize = LevelBar.AbsoluteSize.X
		local mouseX = mouse.X

		if mouseX >= sliderPos and mouseX <= sliderPos + sliderSize then
			local percent = (mouseX - sliderPos) / sliderSize
			updateLevel(percent * 100)
		end
	end
end)

