_G.G_RemoveLava = true
_G.G_WalkOnWater = true

-- ============================================================
-- Graphics 関数群
-- ============================================================

local function fn17(arg)
	local level = _G.GraphicsLevel / 100
	
	if arg:IsA("Part") or arg:IsA("Union") or arg:IsA("CornerWedgePart") or arg:IsA("TrussPart") then
		arg.Material = Enum.Material.SmoothPlastic
		arg.Reflectance = 0.5 * level
		arg.Transparency = 1 - (0.95 * level)
		if level < 0.3 then
			arg.CanCollide = false
		end
	elseif arg:IsA("Decal") or arg:IsA("Texture") then
		arg.Transparency = 1 - (0.9 * level)
	elseif arg:IsA("ParticleEmitter") or arg:IsA("Trail") then
		arg.Lifetime = NumberRange.new(5 * level)
		if level < 0.5 then
			arg.Enabled = false
		end
	elseif arg:IsA("Explosion") then
		arg.BlastPressure = 500 * level
		arg.BlastRadius = 80 * level
	elseif arg:IsA("Fire") or arg:IsA("SpotLight") or arg:IsA("Smoke") then
		arg.Enabled = level > 0.3
	end
end

local function fn18()
	task.spawn(function()
		pcall(function()
			local n = 0

			for _, descendant in pairs(game:GetDescendants()) do
				fn17(descendant)
				n += 1

				if n % 500 == 0 then
					task.wait()
				end
			end
		end)

		print("[Graphics] 画質調整処理完了（Level: " .. _G.GraphicsLevel .. "/100）")
	end)
end

local function fn13(arg)
	if not arg then
		return
	end
	local name = arg.Name

	if name == "Lava" then
		pcall(function()
			arg:Destroy()
		end)
	elseif name == "LavaParts" then
		local parent = arg.Parent

		if parent then
			local name2 = parent.Name

			if name2 == "CircleIsland" or name2 == "GhostShipInterior" then
				local parent2 = parent.Parent

				if parent2 and parent2.Name == "Map" then
					pcall(function()
						arg:Destroy()
					end)
				end
			end
		end
	end
end

local function fn14()
	task.spawn(function()
		pcall(function()
			local n = 0

			for _, descendant in pairs(game:GetService("Workspace"):GetDescendants()) do
				fn13(descendant)
				n += 1

				if n % 500 == 0 then
					task.wait()
				end
			end

			for _, descendant in pairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
				fn13(descendant)
				n += 1

				if n % 500 == 0 then
					task.wait()
				end
			end
		end)

		print("[Graphics] 溶岩除去完了（再ログインで復元）")
	end)
end

local flag3 = false

local function fn15()
	if flag3 then
		return
	end
	flag3 = true

	task.spawn(function()
		while task.wait(0.2) do
			if _G.G_WalkOnWater then
				pcall(function()
					local waterBasePlane = game:GetService("Workspace"):FindFirstChild("Map") and game.Workspace.Map:FindFirstChild("WaterBase-Plane")

					if waterBasePlane then
						waterBasePlane.Size = Vector3.new(1000, 112, 1000)
					end
				end)

				continue
			end

			break
		end

		flag3 = false
	end)
end

local function fn16()
	_G.G_WalkOnWater = false

	pcall(function()
		local waterBasePlane = game:GetService("Workspace"):FindFirstChild("Map") and game.Workspace.Map:FindFirstChild("WaterBase-Plane")

		if waterBasePlane then
			waterBasePlane.Size = Vector3.new(1000, 80, 1000)
		end
	end)
end

-- 初期化
fn18()
fn14()
fn15()

game:GetService("Workspace").DescendantAdded:Connect(function(descendant)
	if _G.G_LowGraphics then
		pcall(fn17, descendant)
	end
end)

